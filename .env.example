# Токен бота из @BotFather
BOT_TOKEN=123456:AA...

# Путь до файла базы (SQLite)
DB_PATH=fightclub.db

# Кулдаун хода: сколько секунд даётся бойцу на выбор удара и блоков
TURN_TIMEOUT=30

# Сколько секунд живёт неотвеченный вызов на дуэль
CHALLENGE_TIMEOUT=180

# Отдых между раундами: судья разводит бойцов по углам на столько секунд.
# 0 — драться без перерывов.
ROUND_BREAK=30

# Сколько секунд идёт сбор состава на групповой бой и королевскую битву
LOBBY_TIMEOUT=180

# Сколько секунд идёт запись на турнир (по умолчанию сутки)
TOURNAMENT_REGISTRATION=86400

# --- Карточка персонажа (мини-апп Telegram) ---
# Публичный HTTPS-адрес, на котором доступен мини-апп.
# Пусто — карточка не поднимается, бот работает как раньше.
# На Railway можно не задавать: адрес возьмётся из RAILWAY_PUBLIC_DOMAIN.
WEBAPP_URL=https://example.com

# Где слушать локально (за реверс-прокси или туннелем).
# Если хостинг подставляет PORT, он важнее WEBAPP_PORT.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Короткое имя мини-аппа из BotFather (/newapp).
# Нужно, чтобы имя бойца в чате открывало карточку во всплывающем окне.
# ВАЖНО: приложение с этим именем должно быть заведено в BotFather. Если его
# нет, Telegram молча открывает чат с ботом вместо карточки. Проверить, какая
# ссылка стоит под именем бойца, можно командой /miniapp.
MINIAPP_NAME=card

# Мини-апп включён главным (BotFather → Bot Settings → Configure Mini App).
# Тогда короткое имя не нужно: оставьте MINIAPP_NAME пустым и поставьте 1.
MINIAPP_MAIN=

# --- Группа клуба ---
# Куда бот зовёт новичка сразу после создания бойца.
# Пусто — берётся приглашение в «Бойцовский клуб Вегас».
CLUB_URL=
CLUB_TITLE=

# --- Владелец клуба ---
# Телеграм-id владельца: только ему отвечает /givepro — выдача подписки PRO
# руками. Пусто — владельца нет, и команда не работает ни у кого.
# Свой id можно узнать у @userinfobot.
OWNER_ID=

# «Чёрный пуск»: разбор рейда без окна входа и с серверными союзниками.
# Только для разработки — в городе окно входа каждый вечер в 19:00 по
# Москве, состав собирают живые люди, и у каждого свой откат: трое
# суток после пройденного рейда, три часа после смерти
BLACKOUT_SANDBOX=0

# Разовые окна входа в «Чёрный пуск», по московским часам, через
# запятую: BLACKOUT_WINDOWS=2026-10-30T23:30/2026-10-31T00:30
# Пусто — то, что записано в bot/game/blackout.py; «-» — только
# расписание города (каждый вечер в 19:00)
BLACKOUT_WINDOWS=
